#!/usr/bin/env bash
# The go-sandbox check: gofmt, vet, staticcheck and test, in that order. Every
# stage runs even after an earlier one failed, and none needs another's output.
# A stage is recorded as not-run when its tool is not on PATH. Go uses only the
# modules locked in projects/go-sandbox/go.sum, and staticcheck is pinned as a
# tool in projects/go-sandbox/go.mod. Prints a summary table, or with --json one
# JSON line on stdout and all tool output on stderr. Exits 0 only if every
# stage passed, 1 otherwise, 2 on bad usage.
set -uo pipefail
cd "$(dirname "$0")"

# This makes Go use only the modules locked in projects/go-sandbox/go.sum and
# never rewrite go.mod or go.sum, whatever GOFLAGS the caller had.
export GOFLAGS=-mod=readonly

json=0
if [[ $# -gt 1 || ( $# -eq 1 && $1 != --json ) ]]; then
  echo "usage: projects/go-sandbox/check [--json]" >&2
  exit 2
fi
[[ $# -eq 1 ]] && json=1

names=(gofmt vet staticcheck test)
cmds=(
  "gofmt -l ."
  "go vet ./..."
  "go tool staticcheck ./..."
  "go test -race -count=1 ./..."
)
total=${#names[@]}
statuses=()
durations=()
passed=0

# gofmt -l exits 0 even when it lists files, so this fails when it lists any.
run_gofmt() {
  local listed rc
  listed=$(gofmt -l .)
  rc=$?
  if [[ $rc != 0 ]]; then
    return "$rc"
  fi
  if [[ -n $listed ]]; then
    printf 'gofmt: these files need formatting:\n%s\n' "$listed"
    return 1
  fi
}

# fd 5 receives each stage's tool output: stderr in --json mode, else stdout.
if [[ $json == 1 ]]; then exec 5>&2; else exec 5>&1; fi
# bash 3.2 has no millisecond clock, so read `time` with %3R (seconds as 1.234).
TIMEFORMAT='%3R'

for ((i = 0; i < total; i++)); do
  tool=${cmds[$i]%% *}
  if ! command -v "$tool" > /dev/null 2>&1; then
    echo "==> ${names[$i]}: not-run, $tool is not on PATH" >&2
    statuses[$i]=not-run
    durations[$i]=0
    continue
  fi
  echo "==> ${names[$i]}: ${cmds[$i]}" >&2
  if [[ ${names[$i]} == gofmt ]]; then
    runner=run_gofmt
  else
    runner=${cmds[$i]}
  fi
  # The group's stderr carries time's report, then the command's exit code.
  res=$( { time $runner >&5 2>&5; echo "rc=$?" >&2; } 2>&1 )
  rc=${res##*rc=}
  digits=${res%%$'\n'*}
  digits=${digits//[!0-9]/}
  durations[$i]=$((10#$digits))
  if [[ $rc == 0 ]]; then
    statuses[$i]=pass
    passed=$((passed + 1))
  else
    statuses[$i]=fail
  fi
done

if [[ $json == 1 ]]; then
  # Stage names and commands contain nothing that needs JSON escaping.
  stages=
  for ((i = 0; i < total; i++)); do
    [[ -n $stages ]] && stages+=', '
    stages+="{\"name\": \"${names[$i]}\", \"status\": \"${statuses[$i]}\", "
    stages+="\"duration_ms\": ${durations[$i]}, \"command\": \"${cmds[$i]}\"}"
  done
  printf '{"project": "go-sandbox", "stack": "go", "stages": [%s], "passed": %d, "total": %d}\n' \
    "$stages" "$passed" "$total"
else
  printf '\n%-12s %-8s %s\n' stage status duration_ms
  for ((i = 0; i < total; i++)); do
    printf '%-12s %-8s %s\n' "${names[$i]}" "${statuses[$i]}" "${durations[$i]}"
  done
  printf 'passed %d of %d\n' "$passed" "$total"
fi
[[ $passed == "$total" ]]
